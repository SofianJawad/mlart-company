---
/**
 * En-tête : navigation principale + menu mobile.
 * Le sous-menu « Nos spectacles » est généré dynamiquement depuis la collection
 * du CMS : un spectacle ajouté dans le panneau apparaît automatiquement ici.
 */
import Logo from './Logo.astro';
import { getCollection } from 'astro:content';

const { currentPath = '/' } = Astro.props;

const shows = (await getCollection('spectacles')).sort((a, b) => a.data.order - b.data.order);

const showChildren = [
  { label: 'Tous nos spectacles', href: '/spectacles/' },
  ...shows.map((s) => ({ label: s.data.title, href: `/spectacles/${s.slug}/` })),
];

const navItems = [
  { label: 'Accueil', href: '/' },
  { label: 'Qui sommes-nous ?', href: '/qui-sommes-nous/' },
  { label: 'Nos spectacles', href: '/spectacles/', children: showChildren },
  { label: 'Événementiel & sur-mesure', href: '/evenementiel/' },
  { label: 'Ateliers', href: '/ateliers/' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href);
}

function isChildActive(href: string): boolean {
  if (href === '/spectacles/') return currentPath === '/spectacles/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <Logo />

    <nav class="main-nav" aria-label="Navigation principale">
      <ul>
        {
          navItems.map((item) =>
            item.children ? (
              <li class="has-dropdown">
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  <span class="caret" aria-hidden="true">
                    <svg width="10" height="6" viewBox="0 0 10 6" fill="none">
                      <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </a>
                <ul class="dropdown">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class={child.href === '/spectacles/' ? 'dropdown__all' : undefined}
                        aria-current={isChildActive(child.href) ? 'page' : undefined}
                      >
                        <span>{child.label}</span>
                        {child.href === '/spectacles/' && <span class="dropdown__arrow" aria-hidden="true">→</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="nav-cta">
      <a class="btn btn--gold" href="/contact/">Programmer</a>
    </div>

    <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Ouvrir le menu">
      <span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu">
  <ul>
    {
      navItems.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
          {item.children && (
            <ul class="submenu">
              {item.children.map((child) => (
                <li>
                  <a href={child.href}>{child.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
  <div class="nav-cta-mobile">
    <a class="btn btn--gold" href="/contact/">Programmer un spectacle</a>
  </div>
</div>
