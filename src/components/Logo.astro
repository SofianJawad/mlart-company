---
/**
 * Logo ML'Art Company
 * Marque : cercle doré + « M » + étoile
 */
const { small = false } = Astro.props;
---

<a class="brand" href="/" aria-label="ML'Art Company — Accueil">
  <svg
    class="brand__mark"
    viewBox="0 0 48 48"
    fill="none"
    aria-hidden="true"
  >
    <circle cx="24" cy="24" r="22.5" stroke="var(--gold-light)" stroke-width="2" />
    <circle cx="24" cy="24" r="18.5" stroke="rgba(232,205,139,0.35)" stroke-width="1" />
    <text
      x="24"
      y="31.5"
      text-anchor="middle"
      font-family="Georgia, 'Times New Roman', serif"
      font-style="italic"
      font-weight="700"
      font-size="22"
      fill="var(--gold-light)"
    >M</text>
    <path
      d="M40.2 8.4l1.1 2.6 2.6 1.1-2.6 1.1-1.1 2.6-1.1-2.6-2.6-1.1 2.6-1.1z"
      fill="var(--gold)"
    />
  </svg>
  <span class="brand__name">
    ML'Art
    <small>Company</small>
  </span>
</a>
