---
/**
 * Page de confirmation après envoi du formulaire de contact
 */
import Base from '../layouts/Base.astro';
---

<Base title="Merci ! — ML'Art Company">
  <section class="section section--cream">
    <div class="container">
      <div class="cta-band reveal" style="text-align:center">
        <span class="kicker" style="justify-content:center">Message envoyé</span>
        <h2>Merci pour votre message !</h2>
        <p>
          Nous avons bien reçu votre demande et nous vous répondrons dans les plus brefs délais.
          À très vite sur scène !
        </p>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn--gold btn--arrow" href="/">Retour à l'accueil</a>
          <a class="btn btn--outline btn--arrow" href="/spectacles/">Découvrir nos spectacles</a>
        </div>
      </div>
    </div>
  </section>
</Base>
