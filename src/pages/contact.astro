---
/**
 * Contact — formulaire Netlify Forms (gratuit) + coordonnées depuis le CMS
 */
import Base from '../layouts/Base.astro';
import HeroArt from '../components/HeroArt.astro';
import { getCollection } from 'astro:content';

const contactEntry = (await getCollection('settings')).find((e) => e.slug === 'contact');
const c = contactEntry?.data;
---

<Base
  title="Contact — Parlons de votre projet"
  description="Contactez ML'Art Company pour programmer un spectacle, une prestation événementielle, un atelier ou pour soutenir la compagnie. Nous intervenons partout en France."
>
  <section class="page-hero">
    <div class="page-hero__art"><HeroArt /></div>
    <div class="container page-hero__inner">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="/">Accueil</a>
        <span aria-hidden="true">→</span>
        <span aria-current="page">Contact</span>
      </nav>
      <span class="kicker">Parlons-en</span>
      <h1>Contactez ML'Art Company</h1>
      <p class="lead">
        Programmer un spectacle, imaginer une création sur-mesure, organiser un atelier ou soutenir
        la compagnie : écrivez-nous, nous répondons à chaque demande.
      </p>
    </div>
  </section>

  <section class="section section--cream">
    <div class="container">
      <div class="contact-grid">
        <!-- Formulaire (Netlify Forms — notifications par email à activer dans Netlify) -->
        <div class="form-card reveal">
          <h2 style="margin-bottom:1.2rem">Votre message</h2>
          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action="/merci/"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p style="display:none" aria-hidden="true">
              <label>Ne pas remplir ce champ <input name="bot-field" /></label>
            </p>

            <div class="form-grid">
              <div class="form-field">
                <label for="nom">Nom *</label>
                <input id="nom" name="nom" type="text" required autocomplete="name" />
              </div>
              <div class="form-field">
                <label for="email">Email *</label>
                <input id="email" name="email" type="email" required autocomplete="email" />
              </div>
              <div class="form-field">
                <label for="structure">Structure / organisme</label>
                <input id="structure" name="structure" type="text" autocomplete="organization" />
              </div>
              <div class="form-field">
                <label for="objet">Objet *</label>
                <select id="objet" name="objet" required>
                  <option value="">Choisir…</option>
                  <option>Programmer un spectacle</option>
                  <option>Prestation événementielle / sur-mesure</option>
                  <option>Atelier de pratique artistique</option>
                  <option>Soutenir ML'Art Company</option>
                  <option>Autre demande</option>
                </select>
              </div>
              <div class="form-field form-field--full">
                <label for="message">Votre message *</label>
                <textarea
                  id="message"
                  name="message"
                  required
                  placeholder="Parlez-nous de votre projet : date envisagée, lieu, public, budget indicatif…"
                ></textarea>
              </div>
            </div>

            <div class="form-actions">
              <button class="btn btn--gold btn--arrow" type="submit">Envoyer mon message</button>
              <p class="form-note">Réponse rapide garantie — nous lisons chaque message.</p>
            </div>
          </form>
        </div>

        <!-- Coordonnées (éditables depuis le CMS) -->
        <aside class="info-card reveal">
          <h2>Nos coordonnées</h2>
          <ul>
            {c?.email && (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="3" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
                <a href={`mailto:${c.email}`}>{c.email}</a>
              </li>
            )}
            {c?.phone && (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <path d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" />
                </svg>
                <span>{c.phone}</span>
              </li>
            )}
            {c?.address && (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z" />
                  <circle cx="12" cy="10" r="2.6" />
                </svg>
                <span>{c.address}</span>
              </li>
            )}
          </ul>
          <p style="margin-top:1.4rem;color:rgba(250,245,236,0.85)">
            Nos artistes se déplacent <strong>partout en France</strong> : théâtres, salles des
            fêtes, espaces publics, entreprises, festivals…
          </p>
          {c && (
            <div class="social-row">
              {c.instagram && (
                <a href={c.instagram} target="_blank" rel="noopener" aria-label="Instagram">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
                  </svg>
                </a>
              )}
              {c.facebook && (
                <a href={c.facebook} target="_blank" rel="noopener" aria-label="Facebook">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.5V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H7.9v3h2.6V21h3z" />
                  </svg>
                </a>
              )}
            </div>
          )}
        </aside>
      </div>
    </div>
  </section>
</Base>
