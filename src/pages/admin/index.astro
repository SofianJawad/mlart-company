---
// Panneau d'administration Decap CMS — servi à /admin/
// (page autonome, sans en-tête ni pied de page du site)
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Administration — ML'Art Company</title>
  </head>
  <body>
    <!-- Panneau d'administration Decap CMS (gratuit et open source).
         En local : lancer `npm run admin` dans un second terminal.
         En production : connexion via Netlify Identity.
         NB : is:inline obligatoire pour qu'Astro laisse ces scripts intacts. -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
  </body>
</html>
