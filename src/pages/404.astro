---
/**
 * Page 404
 */
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable — ML'Art Company">
  <section class="section section--cream">
    <div class="container">
      <div class="cta-band reveal" style="text-align:center">
        <span class="kicker" style="justify-content:center">404</span>
        <h2>Cette page s'est envolée…</h2>
        <p>La page que vous cherchez n'existe pas ou a été déplacée. Retrouvez notre univers dès la page d'accueil !</p>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn--gold btn--arrow" href="/">Retour à l'accueil</a>
        </div>
      </div>
    </div>
  </section>
</Base>
